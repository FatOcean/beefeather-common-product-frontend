html,
body {
  font: 12px/1.5 "Helvetica Neue",Helvetica,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","微软雅黑",Arial,sans-serif;
  font-weight: 400;
  line-height: 1.5;
  color: #333;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track-piece { background-color: #fff; -webkit-border-radius: 5px; }
::-webkit-scrollbar-thumb:vertical { height: 8px; background-color: #e0e0e0; -webkit-border-radius: 5px; }
::-webkit-scrollbar-thumb:horizontal { width: 8px; background-color: #e0e0e0; -webkit-border-radius: 5px; }

// @font-face {
//   font-family: 'SourceHanSansCN';
//   src: url('../fonts/SourceHanSansCN-Regular.otf');
// }

*,
*:before,
*:after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

div:focus{
  outline: none;
}

a:focus,
a:active {
  outline: none;
}

a,
a:focus,
a:hover {
  cursor: pointer;
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

button,
input,
select,
textarea {
  font-family: inherit;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
}
